<%= form_with(model: stock_house, builder: TailwindFormBuilder) do |form| %>
  <%= render 'shared/form_errors', object: stock_house %>

  <div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :name %>
        <%= form.text_field :name, placeholder: 'Enter stock house name' %>
      </div>

      <div>
        <%= form.label :location %>
        <%= form.text_field :location, placeholder: 'Enter location address' %>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-200">
      <%= link_to 'Cancel', stock_houses_path, class: 'inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition' %>
      <%= form.submit stock_house.new_record? ? 'Create Stock House' : 'Update Stock House' %>
    </div>
  </div>
<% end %>
