<div class="mb-4">
  <%= form.label label_text, class: "block text-sm font-medium text-gray-900 mb-2" %>
  <%= form.text_field field_name, 
    class: "w-full px-4 py-2 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-200 transition",
    placeholder: placeholder,
    **options
  %>
  <% if help_text %>
    <p class="mt-1 text-xs text-gray-500"><%= help_text %></p>
  <% end %>
</div>
