<div class="bg-white rounded-lg border border-gray-200 p-6 hover:shadow-lg transition">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-gray-600 text-sm font-medium"><%= label %></p>
      <p class="text-3xl font-bold text-gray-900 mt-2"><%= value %></p>
      <% if subtext.present? %>
        <p class="text-gray-500 text-xs mt-2"><%= subtext %></p>
      <% end %>
      <% if trend.present? %>
        <div class="mt-3 flex items-center gap-2">
          <% if trend[:positive] %>
            <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-green-600 text-sm font-medium"><%= trend[:text] %></span>
          <% else %>
            <svg class="w-4 h-4 text-red-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M14.707 10.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 12.586V5a1 1 0 012 0v7.586l2.293-2.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-red-600 text-sm font-medium"><%= trend[:text] %></span>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="flex items-center justify-center h-12 w-12 rounded-lg <%= icon_bg_color %>">
      <svg class="w-6 h-6 <%= icon_color %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <%= icon_path.html_safe %>
      </svg>
    </div>
  </div>
</div>
