<%= form_with(model: jute_stock, local: true) do |form| %>
  <% if jute_stock.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(jute_stock.errors.count, "error") %> prohibited this jute_stock from being saved:</h2>

      <ul>
        <% jute_stock.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :stock_house_id %>
    <%= form.collection_select :stock_house_id, StockHouse.all, :id, :name, prompt: true %>
  </div>

  <div class="field">
    <% if jute_stock.respond_to?(:has_attribute?) && jute_stock.has_attribute?("product_id") %>
      <%= form.label :product_id, 'Product' %>
      <%= form.collection_select :product_id, Product.all.order(:name), :id, :name, include_blank: true %>
    <% else %>
      <%= form.label :jute_quality %>
      <%= form.text_field :jute_quality %>
    <% end %>
  </div>

  <div class="field">
    <%= form.label :quantity, 'Quantity (kg)' %>
    <%= form.text_field :quantity %>
  </div>

  <div class="field">
    <%= form.label :last_updated %>
    <%= form.datetime_field :last_updated %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
