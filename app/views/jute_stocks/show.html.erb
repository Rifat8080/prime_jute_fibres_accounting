<p id="notice"><%= notice %></p>

<h1>Jute Stock</h1>

<p>
  <strong>Stock house:</strong>
  <%= @jute_stock.stock_house&.name %>
</p>

<p>
  <strong>Jute quality:</strong>
  <%= @jute_stock.jute_quality %>
</p>

<p>
  <strong>Quantity (kg):</strong>
  <%= number_with_precision(@jute_stock.quantity_value, precision: 3) %>
</p>

<p>
  <strong>Last updated:</strong>
  <%= @jute_stock.last_updated %>
</p>

<h2>Stock Movements</h2>

<p>
  <%= link_to 'View all stock movements for this stock', stock_movements_path(jute_stock_id: @jute_stock.id) %> |
  <%= link_to 'New stock movement for this stock', new_stock_movement_path(jute_stock_id: @jute_stock.id) %>
</p>

<% order_col = (defined?(StockMovement) && StockMovement.table_exists? && StockMovement.column_names.include?('movement_date')) ? 'movement_date' : 'created_at' %>
<% recent = @jute_stock.stock_movements.order(Arel.sql("#{order_col} DESC")).limit(10).to_a %>
<% if recent.any? %>
  <table>
    <thead>
      <tr>
        <th>Type</th>
        <th>Quantity</th>
        <th>Date</th>
        <th>Notes</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% recent.each do |sm| %>
        <% qty = if sm.respond_to?(:has_attribute?) && sm.has_attribute?("quantity_bales") && sm["quantity_bales"].present?
                   sm["quantity_bales"]
                 elsif sm.respond_to?(:has_attribute?) && sm.has_attribute?("quantity") && sm["quantity"].present?
                   sm["quantity"]
                 elsif sm.respond_to?(:movement_quantity)
                   sm.movement_quantity
                 else
                   nil
                 end %>
        <% mdate = (sm.respond_to?(:has_attribute?) && sm.has_attribute?("movement_date") && sm["movement_date"].present?) ? sm["movement_date"] : sm.created_at %>
        <% notes = sm.respond_to?(:has_attribute?) && sm.has_attribute?("notes") ? sm["notes"] : (sm.respond_to?(:notes) ? sm.notes : nil) %>
        <tr>
          <td><%= sm.movement_type %></td>
          <td><%= qty %></td>
          <td><%= mdate %></td>
          <td><%= truncate(notes, length: 50) %></td>
          <td><%= link_to 'Show', stock_movement_path(sm) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No stock movements recorded for this stock.</p>
<% end %>

<h2>Processing Batches</h2>
<% pbs = @jute_stock.processing_batches %>
<% if pbs.any? %>
  <table>
    <thead>
      <tr>
        <th>Batch No / ID</th>
        <th>Processed Date</th>
        <th>Input Qty</th>
        <th>Output Qty</th>
        <th>Waste Qty</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% pbs.order(processed_date: :desc).each do |pb| %>
        <tr>
          <td><%= pb.batch_no.presence || pb.id %></td>
          <td><%= pb.processed_date %></td>
          <td><%= number_with_precision(pb.input_quantity || 0, precision: 3) %></td>
          <td><%= number_with_precision(pb.output_quantity || 0, precision: 3) %></td>
          <td><%= number_with_precision(pb.waste_quantity || 0, precision: 3) %></td>
          <td><%= link_to 'Show', processing_batch_path(pb) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No processing batches related to this stock.</p>
<% end %>

<%= link_to 'Edit', edit_jute_stock_path(@jute_stock) %> |
<%= link_to 'Back', jute_stocks_path %>
