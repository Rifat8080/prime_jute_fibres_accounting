<div class="relative group">
  <button type="button" class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition">
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
    </svg>
    <span class="hidden sm:inline"><%= current_user.email %></span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
    <div class="px-4 py-3 border-b border-gray-100">
      <p class="text-sm font-medium text-gray-900"><%= current_user.email %></p>
    </div>
    
    <ul class="py-2">
      <li>
        <%= link_to 'Dashboard', dashboard_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-amber-50 hover:text-amber-700 transition" %>
      </li>
      <li>
        <%= link_to 'Accounts', accounts_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-amber-50 hover:text-amber-700 transition" %>
      </li>
      <li class="border-t border-gray-100">
        <%= button_to 'Sign Out', destroy_user_session_path, method: :delete, form: { class: "m-0" }, class: "block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 hover:text-red-700 transition" %>
      </li>
    </ul>
  </div>
</div>