<h1>Buyers</h1>

<div id="buyers">
  <table>
    <thead>
      <tr>
        <th>Company name</th>
        <th>Contact person</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Address</th>
        <th>Country</th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @buyers.each do |buyer| %>
        <tr>
          <td><%= buyer.company_name %></td>
          <td><%= buyer.contact_person %></td>
          <td><%= buyer.email %></td>
          <td><%= buyer.phone %></td>
          <td><%= buyer.address %></td>
          <td><%= buyer.country %></td>
          <td><%= link_to 'Show', buyer %></td>
          <td><%= link_to 'Edit', edit_buyer_path(buyer) %></td>
          <td><%= link_to 'Destroy', buyer, method: :delete, data: { confirm: 'Are you sure?' } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to 'New buyer', new_buyer_path %>
