<div class="w-full">
  <div class="flex justify-between items-center mb-4">
    <h1 class="font-bold text-4xl">Users</h1>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full bg-white">
      <thead class="bg-gray-800 text-white">
        <tr>
          <th class="text-left py-3 px-4 uppercase font-semibold text-sm">Name</th>
          <th class="text-left py-3 px-4 uppercase font-semibold text-sm">Email</th>
          <th class="text-left py-3 px-4 uppercase font-semibold text-sm">Phone</th>
          <th class="text-left py-3 px-4 uppercase font-semibold text-sm">Designation</th>
          <th class="text-left py-3 px-4 uppercase font-semibold text-sm">Role</th>
          <th class="text-left py-3 px-4 uppercase font-semibold text-sm">Actions</th>
        </tr>
      </thead>
      <tbody class="text-gray-700">
        <% @users.each do |user| %>
          <tr>
            <td class="text-left py-3 px-4"><%= user.name %></td>
            <td class="text-left py-3 px-4"><%= user.email %></td>
            <td class="text-left py-3 px-4"><%= user.phone %></td>
            <td class="text-left py-3 px-4"><%= user.designation %></td>
            <td class="text-left py-3 px-4"><%= user.role %></td>
            <td class="text-left py-3 px-4">
              <%= link_to 'Show', user, class: "text-blue-500 hover:text-blue-700" %>
              <%= link_to 'Edit', edit_user_path(user), class: "text-blue-500 hover:text-blue-700 ml-2" %>
              <%= link_to 'Destroy', user, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-500 hover:text-red-700 ml-2" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
