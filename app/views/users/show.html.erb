<div class="w-full">
  <div class="flex justify-between items-center mb-4">
    <h1 class="font-bold text-4xl">User Details</h1>
  </div>

  <div class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
    <div class="mb-4">
      <p class="block text-gray-700 text-sm font-bold mb-2">Name:</p>
      <p class="text-gray-700"><%= @user.name %></p>
    </div>
    <div class="mb-4">
      <p class="block text-gray-700 text-sm font-bold mb-2">Email:</p>
      <p class="text-gray-700"><%= @user.email %></p>
    </div>
    <div class="mb-4">
      <p class="block text-gray-700 text-sm font-bold mb-2">Phone:</p>
      <p class="text-gray-700"><%= @user.phone %></p>
    </div>
    <div class="mb-4">
      <p class="block text-gray-700 text-sm font-bold mb-2">Designation:</p>
      <p class="text-gray-700"><%= @user.designation %></p>
    </div>
    <div class="mb-4">
      <p class="block text-gray-700 text-sm font-bold mb-2">Role:</p>
      <p class="text-gray-700"><%= @user.role %></p>
    </div>

    <div class="flex items-center justify-between">
      <%= link_to 'Edit', edit_user_path(@user), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      <%= link_to 'Back', users_path, class: "bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>
</div>
