<h1>Transactions</h1>

<div id="transactions">
  <table>
    <thead>
      <tr>
        <th>Account</th>
        <th>Related entity</th>
        <th>Transaction date</th>
        <th>Transaction type</th>
        <th>Amount</th>
        <th>Description</th>
        <th>Category</th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @transactions.each do |transaction| %>
        <tr>
          <td><%= transaction.account.name %></td>
          <td><%= transaction.related_entity_type %>: <%= transaction.related_entity_id %></td>
          <td><%= transaction.transaction_date %></td>
          <td><%= transaction.transaction_type %></td>
          <td><%= transaction.amount %></td>
          <td><%= transaction.description %></td>
          <td><%= transaction.category %></td>
          <td><%= link_to 'Show', [@account, transaction] %></td>
          <td><%= link_to 'Edit', edit_account_transaction_path(@account, transaction) %></td>
          <td><%= link_to 'Destroy', [@account, transaction], method: :delete, data: { confirm: 'Are you sure?' } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to 'New transaction', new_account_transaction_path(@account) %>
