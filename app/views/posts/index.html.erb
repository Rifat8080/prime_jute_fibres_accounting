<!-- Hero Section -->
<section class="py-20 md:py-32">
  <div class="max-w-4xl mx-auto text-center">
    <div class="mb-8">
      <div class="inline-flex items-center justify-center h-16 w-16 rounded-lg bg-gradient-to-br from-amber-600 to-amber-700 mb-6">
        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
        </svg>
      </div>
      <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-4">
        Prime Jute Fibres
      </h1>
      <p class="text-xl text-gray-600 mb-8">
        Professional Supply Chain & Accounting Management for Jute Industry
      </p>
    </div>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
      <% if user_signed_in? %>
        <%= link_to 'Go to Dashboard', dashboard_path, class: "px-8 py-3 bg-amber-600 text-white rounded-lg font-semibold hover:bg-amber-700 transition transform hover:scale-105" %>
      <% else %>
        <%= link_to 'Get Started', new_user_registration_path, class: "px-8 py-3 bg-amber-600 text-white rounded-lg font-semibold hover:bg-amber-700 transition transform hover:scale-105" %>
        <%= link_to 'Sign In', new_user_session_path, class: "px-8 py-3 border-2 border-amber-600 text-amber-600 rounded-lg font-semibold hover:bg-amber-50 transition" %>
      <% end %>
    </div>

    <div class="inline-block px-6 py-2 bg-amber-100 rounded-full text-sm text-amber-800 font-medium">
      ✨ Professional Business Management Solution
    </div>
  </div>
</section>

