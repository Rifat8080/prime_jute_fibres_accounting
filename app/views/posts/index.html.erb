<!-- FAQ Section -->
<section class="py-16 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <h3 class="font-bold text-gray-900 mb-2">What is Prime Jute Fibres?</h3>
        <p class="text-gray-600">Prime Jute Fibres is a comprehensive accounting and supply chain management system specifically designed for jute suppliers, offering features like inventory tracking, financial accounting, and sales management.</p>
      </div>

      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <h3 class="font-bold text-gray-900 mb-2">How do I get started?</h3>
        <p class="text-gray-600">Sign up for a free account, and you'll get instant access to the dashboard. Our onboarding team will help you set up your company profile and get started.</p>
      </div>

      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <h3 class="font-bold text-gray-900 mb-2">Is my data secure?</h3>
        <p class="text-gray-600">Yes, we use enterprise-grade encryption and security measures to protect your business data. Your information is backed up regularly and complies with industry standards.</p>
      </div>

      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <h3 class="font-bold text-gray-900 mb-2">Can I export reports?</h3>
        <p class="text-gray-600">Absolutely! You can generate and export various reports in multiple formats (PDF, Excel) for analysis and record-keeping.</p>
      </div>
    </div>
  </div>
</section>
