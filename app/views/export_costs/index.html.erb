<h1>Export Costs</h1>

<div id="export_costs">
  <table>
    <thead>
      <tr>
        <th>Shipment</th>
        <th>Cost type</th>
        <th>Amount</th>
        <th>Description</th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @export_costs.each do |export_cost| %>
        <tr>
          <td><%= export_cost.shipment.invoice_number %></td>
          <td><%= export_cost.cost_type %></td>
          <td><%= export_cost.amount %></td>
          <td><%= export_cost.description %></td>
          <td><%= link_to 'Show', export_cost %></td>
          <td><%= link_to 'Edit', edit_export_cost_path(export_cost) %></td>
          <td><%= link_to 'Destroy', export_cost, method: :delete, data: { confirm: 'Are you sure?' } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to 'New export cost', new_export_cost_path %>
