<div class="bg-white p-6 rounded shadow">
  <div class="flex items-start justify-between">
    <div>
      <h1 class="text-2xl font-semibold"><%= @jute_purchase.product&.name || 'Jute Purchase' %></h1>
      <p class="text-sm text-gray-500">Supplier: <strong><%= @jute_purchase.supplier&.name %></strong></p>
      <p class="text-sm text-gray-500">Date: <%= @jute_purchase.purchase_date %></p>
    </div>
    <div class="text-right">
      <p class="text-lg font-medium"><%= number_to_currency(@jute_purchase.total_amount || 0, unit: '৳') %></p>
      <p class="text-sm text-gray-600">Qty: <%= number_with_precision(@jute_purchase.quantity_kg || 0, precision: 3) %> kg</p>
      <p class="text-sm text-gray-600">Rate: <%= number_with_precision(@jute_purchase.rate_per_kg || 0, precision: 2) %></p>
    </div>
  </div>

  <div class="mt-4">
    <h2 class="text-sm font-medium text-gray-700">Notes</h2>
    <p class="mt-2 text-sm text-gray-700"><%= simple_format(@jute_purchase.notes.to_s) %></p>
  </div>

  <div class="mt-6">
    <h2 class="text-sm font-medium text-gray-700">Procurement Costs</h2>
    <% if @jute_purchase.procurement_costs.any? %>
      <div class="mt-2 overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Cost type</th>
              <th class="px-4 py-2 text-right text-sm font-medium text-gray-700">Amount</th>
              <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Cost date</th>
              <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Description</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @jute_purchase.procurement_costs.each do |cost| %>
              <tr>
                <td class="px-4 py-2 text-sm"><%= cost.cost_type %></td>
                <td class="px-4 py-2 text-sm text-right"><%= number_to_currency(cost.amount || 0, unit: '৳') %></td>
                <td class="px-4 py-2 text-sm"><%= cost.cost_date %></td>
                <td class="px-4 py-2 text-sm"><%= truncate(cost.description.to_s, length: 80) %></td>
                <td class="px-4 py-2 text-sm"><%= link_to 'Show', cost, class: 'text-blue-600' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-gray-500">No procurement costs recorded for this purchase.</p>
    <% end %>
  </div>

  <div class="mt-6 flex gap-3">
    <%= link_to 'Add New Procurement Cost', new_procurement_cost_path(costable_id: @jute_purchase.id, costable_type: 'JutePurchase'), class: 'px-3 py-2 bg-indigo-600 text-white rounded' %>
    <%= link_to 'Edit', edit_jute_purchase_path(@jute_purchase), class: 'px-3 py-2 bg-yellow-400 text-black rounded' %>
    <%= link_to 'Back', jute_purchases_path, class: 'px-3 py-2 text-gray-600' %>
  </div>
</div>
