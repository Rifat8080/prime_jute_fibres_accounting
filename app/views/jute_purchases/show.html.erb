<p id="notice"><%= notice %></p>

<h1>Jute Purchase</h1>

<p>
  <strong>Supplier:</strong>
  <%= @jute_purchase.supplier.name %>
</p>

<p>
  <strong>Purchase date:</strong>
  <%= @jute_purchase.purchase_date %>
</p>

<p>
  <strong>Jute variety:</strong>
  <%= @jute_purchase.jute_variety %>
</p>

<p>
  <strong>Quantity kg:</strong>
  <%= @jute_purchase.quantity_kg %>
</p>

<p>
  <strong>Rate per kg:</strong>
  <%= @jute_purchase.rate_per_kg %>
</p>

<p>
  <strong>Total amount:</strong>
  <%= @jute_purchase.total_amount %>
</p>

<p>
  <strong>Notes:</strong>
  <%= @jute_purchase.notes %>
</p>

<h2>Procurement Costs</h2>
<% if @jute_purchase.procurement_costs.any? %>
  <table>
    <thead>
      <tr>
        <th>Cost type</th>
        <th>Amount</th>
        <th>Cost date</th>
        <th>Description</th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @jute_purchase.procurement_costs.each do |cost| %>
        <tr>
          <td><%= cost.cost_type %></td>
          <td><%= cost.amount %></td>
          <td><%= cost.cost_date %></td>
          <td><%= cost.description %></td>
          <td><%= link_to 'Show', cost %></td>
          <td><%= link_to 'Edit', edit_procurement_cost_path(cost) %></td>
          <td><%= link_to 'Destroy', cost, method: :delete, data: { confirm: 'Are you sure?' } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No procurement costs recorded for this purchase.</p>
<% end %>

<%= link_to 'Add New Procurement Cost', new_procurement_cost_path(costable_id: @jute_purchase.id, costable_type: 'JutePurchase') %>

<%= link_to 'Edit', edit_jute_purchase_path(@jute_purchase) %> |
<%= link_to 'Back', jute_purchases_path %>
