<%= form_with(model: jute_purchase, local: true) do |form| %>
  <% if jute_purchase.errors.any? %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded">
      <h3 class="font-semibold">Please fix the following errors:</h3>
      <ul class="mt-2 list-disc list-inside text-sm text-red-700">
        <% jute_purchase.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :supplier_id, class: 'block text-sm font-medium text-gray-700' %>
      <div class="mt-1">
        <%= form.collection_select :supplier_id, Supplier.all.order(:name), :id, :name, { prompt: 'Select supplier' }, { class: 'w-full rounded border-gray-300' } %>
      </div>
    </div>

    <div>
      <%= form.label :purchase_date, class: 'block text-sm font-medium text-gray-700' %>
      <div class="mt-1">
        <%= form.date_field :purchase_date, class: 'w-full rounded border-gray-300' %>
      </div>
    </div>

    <div>
      <%= form.label :stock_house_id, 'Stock house', class: 'block text-sm font-medium text-gray-700' %>
      <div class="mt-1">
        <%= form.collection_select :stock_house_id, StockHouse.all.order(:name), :id, :name, { prompt: 'Select stock house' }, { class: 'w-full rounded border-gray-300' } %>
      </div>
    </div>

    <div>
      <%= form.label :product_id, 'Product (jute variety)', class: 'block text-sm font-medium text-gray-700' %>
      <div class="mt-1">
        <%= form.collection_select :product_id, Product.all.order(:name), :id, :name, { prompt: 'Select product' }, { class: 'w-full rounded border-gray-300' } %>
      </div>
    </div>

    <div>
      <%= form.label :quantity_kg, class: 'block text-sm font-medium text-gray-700' %>
      <div class="mt-1">
        <%= form.number_field :quantity_kg, step: 0.01, class: 'w-full rounded border-gray-300' %>
      </div>
    </div>

    <div>
      <%= form.label :rate_per_kg, class: 'block text-sm font-medium text-gray-700' %>
      <div class="mt-1">
        <%= form.number_field :rate_per_kg, step: 0.01, class: 'w-full rounded border-gray-300' %>
      </div>
    </div>

    <div>
      <%= form.label :total_amount, class: 'block text-sm font-medium text-gray-700' %>
      <div class="mt-1 flex items-center gap-3">
        <%= form.number_field :total_amount, id: 'jute_purchase_total_amount', step: 0.01, class: 'rounded border-gray-300' %>
        <div class="text-sm text-gray-600">Total: <span id="jute_purchase_total_display"><%= number_with_precision(jute_purchase.total_amount || 0, precision: 2) %></span></div>
      </div>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :notes, class: 'block text-sm font-medium text-gray-700' %>
      <div class="mt-1">
        <%= form.text_area :notes, rows: 3, class: 'w-full rounded border-gray-300' %>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <%= form.submit class: 'px-4 py-2 bg-blue-600 text-white rounded' %>
    <%= link_to 'Back', jute_purchases_path, class: 'ml-3 text-sm text-gray-600' %>
  </div>
<% end %>

<script>
  function computeJuteTotal() {
    const qtyEl = document.getElementById('jute_purchase_quantity_kg');
    const rateEl = document.getElementById('jute_purchase_rate_per_kg');
    const totalEl = document.getElementById('jute_purchase_total_amount');
    const displayEl = document.getElementById('jute_purchase_total_display');
    if (!qtyEl || !rateEl || !totalEl) return;
    const qty = parseFloat(qtyEl.value) || 0;
    const rate = parseFloat(rateEl.value) || 0;
    const total = (qty * rate).toFixed(2);
    totalEl.value = total;
    if (displayEl) displayEl.textContent = total;
  }
  document.addEventListener('input', function(e) {
    if (['jute_purchase_quantity_kg','jute_purchase_rate_per_kg'].includes(e.target.id)) {
      computeJuteTotal();
    }
  });
  document.addEventListener('turbo:load', computeJuteTotal);
