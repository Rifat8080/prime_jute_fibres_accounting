<h1>Jute Purchases</h1>

<div id="jute_purchases">
  <table>
    <thead>
      <tr>
        <th>Supplier</th>
        <th>Purchase date</th>
        <th>Jute variety</th>
        <th>Quantity kg</th>
        <th>Rate per kg</th>
        <th>Total amount</th>
        <th>Notes</th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @jute_purchases.each do |jute_purchase| %>
        <tr>
          <td><%= jute_purchase.supplier.name %></td>
          <td><%= jute_purchase.purchase_date %></td>
          <td><%= jute_purchase.jute_variety %></td>
          <td><%= jute_purchase.quantity_kg %></td>
          <td><%= jute_purchase.rate_per_kg %></td>
          <td><%= jute_purchase.total_amount %></td>
          <td><%= jute_purchase.notes %></td>
          <td><%= link_to 'Show', jute_purchase %></td>
          <td><%= link_to 'Edit', edit_jute_purchase_path(jute_purchase) %></td>
          <td><%= link_to 'Destroy', jute_purchase, method: :delete, data: { confirm: 'Are you sure?' } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to 'New jute purchase', new_jute_purchase_path %>
