<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-semibold">Jute Purchases</h1>
  <%= link_to 'New jute purchase', new_jute_purchase_path, class: 'px-3 py-2 bg-green-600 text-white rounded' %>
</div>

<div class="overflow-x-auto bg-white rounded shadow">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Supplier</th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Purchase date</th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Product</th>
        <th class="px-4 py-2 text-right text-sm font-medium text-gray-700">Quantity (kg)</th>
        <th class="px-4 py-2 text-right text-sm font-medium text-gray-700">Rate</th>
        <th class="px-4 py-2 text-right text-sm font-medium text-gray-700">Total</th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Notes</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @jute_purchases.each do |jute_purchase| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-2 text-sm"><%= jute_purchase.supplier&.name %></td>
          <td class="px-4 py-2 text-sm"><%= jute_purchase.purchase_date %></td>
          <td class="px-4 py-2 text-sm"><%= jute_purchase.product&.name || '—' %></td>
          <td class="px-4 py-2 text-sm text-right"><%= number_with_precision(jute_purchase.quantity_kg || 0, precision: 3) %></td>
          <td class="px-4 py-2 text-sm text-right"><%= number_with_precision(jute_purchase.rate_per_kg || 0, precision: 2) %></td>
          <td class="px-4 py-2 text-sm text-right"><%= number_to_currency(jute_purchase.total_amount || 0, unit: '৳') %></td>
          <td class="px-4 py-2 text-sm"><%= truncate(jute_purchase.notes.to_s, length: 80) %></td>
          <td class="px-4 py-2 text-sm">
            <%= link_to 'Show', jute_purchase, class: 'text-blue-600' %>
            <%= link_to 'Edit', edit_jute_purchase_path(jute_purchase), class: 'ml-2 text-gray-600' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
