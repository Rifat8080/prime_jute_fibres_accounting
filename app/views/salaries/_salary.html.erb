<div id="<%= dom_id salary %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">User:</strong>
    <%= salary.user_id %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Payment date:</strong>
    <%= salary.payment_date %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Amount:</strong>
    <%= salary.amount %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Payment period start:</strong>
    <%= salary.payment_period_start %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Payment period end:</strong>
    <%= salary.payment_period_end %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Notes:</strong>
    <%= salary.notes %>
  </p>
</div>
