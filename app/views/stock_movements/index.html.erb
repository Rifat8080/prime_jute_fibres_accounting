<h1>Stock Movements</h1>

<div id="stock_movements">
  <table>
    <thead>
      <tr>
        <th>Jute stock</th>
        <th>Source</th>
        <th>Movement type</th>
        <th>Quantity bales</th>
        <th>Movement date</th>
        <th>Notes</th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @stock_movements.each do |stock_movement| %>
        <tr>
          <td><%= stock_movement.jute_stock.jute_quality %></td>
          <td><%= stock_movement.source_type %>: <%= stock_movement.source_id %></td>
          <td><%= stock_movement.movement_type %></td>
          <td><%= stock_movement.quantity_bales %></td>
          <td><%= stock_movement.movement_date %></td>
          <td><%= stock_movement.notes %></td>
          <td><%= link_to 'Show', stock_movement %></td>
          <td><%= link_to 'Edit', edit_stock_movement_path(stock_movement) %></td>
          <td><%= link_to 'Destroy', stock_movement, method: :delete, data: { confirm: 'Are you sure?' } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to 'New stock movement', new_stock_movement_path %>
