<%= form_with(model: stock_movement, local: true) do |form| %>
  <% if stock_movement.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(stock_movement.errors.count, "error") %> prohibited this stock_movement from being saved:</h2>

      <ul>
        <% stock_movement.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :jute_stock_id %>
    <%= form.collection_select :jute_stock_id, JuteStock.all, :id, :jute_quality, prompt: true %>
  </div>

  <div class="field">
    <%= form.label :source_type %>
    <%= form.text_field :source_type %>
  </div>

  <div class="field">
    <%= form.label :source_id %>
    <%= form.text_field :source_id %>
  </div>

  <div class="field">
    <%= form.label :movement_type %>
    <%= form.select :movement_type, ['in', 'out'], prompt: true %>
  </div>

  <div class="field">
    <%= form.label :quantity_bales %>
    <%= form.text_field :quantity_bales %>
  </div>

  <div class="field">
    <%= form.label :movement_date %>
    <%= form.datetime_field :movement_date %>
  </div>

  <div class="field">
    <%= form.label :notes %>
    <%= form.text_area :notes %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
