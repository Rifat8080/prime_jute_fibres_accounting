<%= form_with(model: stock_movement, local: true) do |f| %>
  <%= render 'shared/form_errors', object: stock_movement %>

  <div class="field">
    <%= f.label :jute_stock_id, "Stock" %><br>
    <% if defined?(JuteStock) && JuteStock.table_exists? && JuteStock.column_names.include?("jute_quality") %>
      <% stocks = JuteStock.order(:jute_quality) %>
    <% else %>
      <% stocks = JuteStock.order(created_at: :desc) %>
    <% end %>
    <%= f.collection_select :jute_stock_id, stocks, :id, :jute_quality, prompt: "Select stock" %>
  </div>

  <div class="field">
    <%= f.label :movement_type %><br>
    <%= f.select :movement_type, [['Incoming','incoming'], ['Outgoing','outgoing'], ['Transfer','transfer']], prompt: 'Select type' %>
  </div>

  <div class="field">
    <%= f.label :quantity, 'Quantity (kg)' %><br>
    <%= f.number_field :quantity, step: 0.01 %>
  </div>

  <div class="field">
    <%= f.label :movement_date %><br>
    <%= f.date_field :movement_date %>
  </div>

  <div class="field">
    <%= f.label :notes %><br>
    <%= f.text_area :notes, rows: 3 %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
<!-- Stock Movements form removed -->
